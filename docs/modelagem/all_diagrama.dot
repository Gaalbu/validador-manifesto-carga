digraph ALL {
  rankdir=LR; nodesep=0.35; ranksep=0.55;
  node [shape=circle, fontname="Helvetica", fontsize=12, width=0.6, fixedsize=true];
  edge [fontname="Helvetica", fontsize=10];
  inicio [shape=point, width=0.08];
  q_acc [shape=doublecircle, label="q_acc", width=0.75];
  q_rej [shape=circle, style=dashed, label="q_rej", width=0.75];
  inicio -> q0;
  q0 -> q1 [label="< / R"];
  q1 -> q2 [label="P / R"];
  q2 -> q2 [label="P / R"];
  q2 -> q3 [label="E / R"];
  q3 -> q3 [label="E / R"];
  q3 -> q4 [label="C / R"];
  q4 -> q4 [label="C / R"];
  q4 -> q5 [label="D / R"];
  q5 -> q5 [label="D / R"];
  q5 -> q6 [label="> / L"];
  q6 -> q6 [label="P,E,C,D,p,e,c,d / L"];
  q6 -> q7 [label="< / R"];
  q7 -> q10 [label="E / R"];
  q7 -> q7 [label="p / R"];
  q7 -> q8 [label="P→p / R"];
  q8 -> q8 [label="P,E,c / R"];
  q8 -> q9 [label="C→c / L"];
  q9 -> q7 [label="< / R"];
  q9 -> q9 [label="P,E,C,D,p,e,c,d / L"];
  q10 -> q10 [label="E,c / R"];
  q10 -> q11 [label="D / L"];
  q11 -> q11 [label="P,E,C,D,p,e,c,d / L"];
  q11 -> q12 [label="< / R"];
  q12 -> q12 [label="p,e / R"];
  q12 -> q13 [label="E→e / R"];
  q12 -> q15 [label="c / R"];
  q13 -> q13 [label="E,c,d / R"];
  q13 -> q14 [label="D→d / L"];
  q14 -> q12 [label="< / R"];
  q14 -> q14 [label="P,E,C,D,p,e,c,d / L"];
  q15 -> q15 [label="c,d / R"];
  q15 -> q_acc [label="> / S"];
  nota [shape=note, fixedsize=false, fontsize=10, label="Qualquer par (estado, símbolo)\nsem aresta vai para q_rej.\nR = direita, L = esquerda, S = parado.\nx→y: lê x, escreve y; x sozinho: reescreve x."];
  nota -> q_rej [style=dotted, arrowhead=none];
}
