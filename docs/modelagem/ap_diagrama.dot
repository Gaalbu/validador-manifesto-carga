digraph AP {
  rankdir=LR; nodesep=0.5; ranksep=0.7;
  node [shape=circle, fontname="Helvetica", fontsize=12, width=0.6, fixedsize=true];
  edge [fontname="Helvetica", fontsize=10];
  inicio [shape=point, width=0.08];
  q8 [shape=doublecircle];
  inicio -> q0;
  q0 -> q1 [label="[, Z / XZ\n{, Z / YZ"];
  q1 -> q1 [label="[, X / XX\n[, Y / XY\n{, X / YX\n{, Y / YY"];
  q1 -> q2 [label="], X / ε\n}, Y / ε"];
  q2 -> q1 [label="ε, X / X\nε, Y / Y"];
  q2 -> q3 [label="ε, Z / Z"];
  q3 -> q1 [label="[, Z / XZ\n{, Z / YZ"];
  q3 -> q4 [label="#, Z / Z"];
  q4 -> q5 [label="P, Z / Z"];
  q5 -> q5 [label="P, Z / Z"];
  q5 -> q6 [label="E, Z / Z"];
  q6 -> q6 [label="E, Z / Z"];
  q6 -> q7 [label="C, Z / Z"];
  q7 -> q7 [label="C, Z / Z"];
  q7 -> q8 [label="D, Z / Z"];
  q8 -> q8 [label="D, Z / Z"];
  nota [shape=note, fixedsize=false, fontsize=10, label="a, Z / γ: lê a com Z no topo e troca Z por γ\n(topo é o 1º símbolo de γ; γ = ε desempilha).\nPilha: Z = fundo, X = [ aberto, Y = { aberto.\nPar ausente = sem transição = rejeita.\nAceita: entrada consumida em q8."];
}
